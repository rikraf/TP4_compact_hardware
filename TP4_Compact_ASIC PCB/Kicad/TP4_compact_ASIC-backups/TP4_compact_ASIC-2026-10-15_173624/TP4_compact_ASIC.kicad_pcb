	(gr_text_box "x4 - external radius. these are M2 clearance, flat head. should be drilled so there is ~.005\" head cleanance on the screw head\nx4 - internal near ASIC.  these are M2 clearance, flat head. should be drilled so there is ~.005\" head cleanance on the screw head"
		(start 176.84322 77.37858)
		(end 219.89622 90.84058)
		(margins 0 0 0 0)

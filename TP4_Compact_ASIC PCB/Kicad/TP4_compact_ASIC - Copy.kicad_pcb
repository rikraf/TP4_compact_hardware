	(gr_text_box "x5 - these are WURTH ELEKTRONIK, WA-SMSI SMT Steel Spacer with internal Thread M2, 1.5mm length, 9774015243R. inserted on bottom.\nSuggested solder pad = 5.3mmDIA, NPTH = 3.0mmDIA\nREF = https://www.we-online.com/components/products/datasheet/9774015243R.pdf\nREF2 = https://www.we-online.com/en/components/products/SMSI_SMT_STEEL_SPACER_M2_THREAD_INTERNAL"
		(start 138.48922 139.60858)
		(end 222.06295 153.07058)
